{
  "name": "atlas-services/hermes-booking-bundle",
  "description": "Booking module for Symfony 8 / Hermes CMS",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "doctrine/orm": "^3.0",
    "symfony/asset-mapper": "^8.0",
    "symfony/config": "^8.0",
    "symfony/dependency-injection": "^8.0",
    "symfony/form": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/http-kernel": "^8.0",
    "symfony/mailer": "^8.0",
    "symfony/routing": "^8.0",
    "symfony/security-bundle": "^8.0",
    "symfony/stimulus-bundle": "^2.0",
    "symfony/translation": "^8.0",
    "symfony/twig-bundle": "^8.0",
    "symfony/validator": "^8.0",
    "twig/twig": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "AtlasServices\\HermesBookingBundle\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
